class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int start = 1;
        int end = h;

        for (int pile : piles) {
            end = Math.max(end, pile);
        }
        
        while(start < end){
            int mid = start + (end - start) / 2;
            int hours = 0;
            for (int i=0; i<piles.length; i++){
                hours += (piles[i] + mid - 1) / mid;
            }
            if(hours <= h){
                end = mid;
            }
            else{
                start = mid + 1;
            }
        }
        return start;
    }
}

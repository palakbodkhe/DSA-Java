class Solution {

    public int findPages(int[] arr, int k) {

        int n = arr.length;

        if (k > n) return -1;

        long low = 0;
        long high = 0;

        // Find maximum element and total sum
        for (int i = 0; i < n; i++) {
            low = Math.max(low, (long) arr[i]);
            high += arr[i];
        }

        while (low <= high) {

            long mid = low + (high - low) / 2;

            if (isPossible(arr, k, mid)) {
                high = mid - 1;
            } else {
                low = mid + 1;
            }
        }

        return (int) low;
    }

    static boolean isPossible(int[] arr, int k, long maxPages) {

        int students = 1;
        long pages = 0;

        for (int i = 0; i < arr.length; i++) {

            if (pages + arr[i] <= maxPages) {
                pages += arr[i];
            } else {
                students++;
                pages = arr[i];

                if (students > k) {
                    return false;
                }
            }
        }

        return true;
    }
}

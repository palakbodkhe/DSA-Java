class Solution {
    public int[] getFloorAndCeil(int[] nums, int x) {
       int left = 0;
       int right = nums.length-1;

       while(left <= right){
        int mid = left + (right-left) / 2;
        if(nums[mid] == x){
            return new int[]{nums[mid], nums[mid]};
        }
        else if(nums[mid] < x){
            left = mid + 1;
        }
        else{
            right = mid - 1;
        }
       }
       return new int[]{nums[right], nums[left]};
    }
}
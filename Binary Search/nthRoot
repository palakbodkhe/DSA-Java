class Solution {

    public int nthRoot(int n, int m) {
        int low = 1;
        int high = m;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            long val = power(mid, n, m);

            if (val == m)
                return mid;
            else if (val < m)
                low = mid + 1;
            else
                high = mid - 1;
        }

        return -1;
    }

    public long power(int base, int exp, int limit) {
        long ans = 1;

        for (int i = 0; i < exp; i++) {
            ans *= base;

            if (ans > limit)
                return ans; // Stop early
        }

        return ans;
    }
}

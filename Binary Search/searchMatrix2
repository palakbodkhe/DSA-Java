class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int i = 0;
        int j = matrix[0].length-1;


        while(i<matrix.length && j>=0){

            int value = matrix[i][j];

            if(value == target){
                return true;
            }

            else if(value < target){
                i++;
            }

            else{
                j--;
            }

        }
        return false;
    }
}

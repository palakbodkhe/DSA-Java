class Solution {
    public int repeatedStringMatch(String a, String b) {
        StringBuilder sb = new StringBuilder();
        int ans =0;

        while(sb.length()<b.length()){
            sb.append(a);
            ans++;
        }
        if(sb.toString().contains(b)){
            return ans;
        }

        sb.append(a);
        ans++;
        if(sb.toString().contains(b))return ans;
       
        return -1;
    }
}

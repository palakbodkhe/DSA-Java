class Solution {
    public int minMeetingRooms(int[] start, int[] end) {

        Arrays.sort(start);
        Arrays.sort(end);

        int count = 0;
        int maxRooms = 0;

        int i = 0;
        int j = 0;

        while(i < start.length){

            if(start[i] < end[j]){
                count++;
                maxRooms = Math.max(maxRooms, count);
                i++;
            }
            else{
                count--;
                j++;
            }
        }

        return maxRooms;
    }
}

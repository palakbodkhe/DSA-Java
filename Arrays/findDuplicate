class Solution {
    public int findDuplicate(int[] nums) {
        HashMap<Integer, Integer> map = new HashMap<>();
        map.put(nums[0], 1);
        int i;

        for( i=1; i<nums.length; i++ ){
            if(map.containsKey(nums[i])){
                break;
            }
            else{
                map.put(nums[i], 1);
            }
        }
        return nums[i];
    }
}

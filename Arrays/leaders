class Solution {
    public List<Integer> leaders(int[] nums) {

        ArrayList<Integer> list = new ArrayList<>();

        int maxRight = Integer.MIN_VALUE;

        for(int i = nums.length - 1; i >= 0; i--) {

            if(nums[i] >= maxRight) {
                list.add(nums[i]);
                maxRight = nums[i];
            }
        }

        Collections.reverse(list);

        return list;
    }
}

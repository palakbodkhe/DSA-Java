class Solution {
    public ArrayList<Integer> calculateSpan(int[] arr) {

        ArrayList<Integer> ans = new ArrayList<>();
        Stack<int[]> st = new Stack<>();

        for (int i = 0; i < arr.length; i++) {

            int span = 1;

            while (!st.isEmpty() && st.peek()[0] <= arr[i]) {
                span += st.peek()[1];
                st.pop();
            }

            st.push(new int[]{arr[i], span});
            ans.add(span);
        }

        return ans;
    }
}

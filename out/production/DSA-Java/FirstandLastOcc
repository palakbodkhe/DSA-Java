class Solution {
    public int[] searchRange(int[] nums, int target) {
        int left=0; int right=nums.length-1; int idx1=-1; int idx2=-1;
        int mid;
        int arr[]= new int[2];

        while(left<=right){
            mid=(left+right)/2;
            if(nums[mid]<target){
                left=mid+1;
            }
            else if(nums[mid]>target){
                right=mid-1;
            }
            else if(nums[mid]==target){
                idx1=mid;
                right=mid-1;
            }
        }

        left = 0;
        right = nums.length - 1;

        while(left<=right){
            mid=(left+right)/2;
            if(nums[mid]<target){
                left=mid+1;
            }
            else if(nums[mid]>target){
                right=mid-1;
            }
            else if(nums[mid]==target){
                idx2=mid;
                left=mid+1;
            }
        }
        arr[0]=idx1;
        arr[1]=idx2;
        return arr;
    }
}

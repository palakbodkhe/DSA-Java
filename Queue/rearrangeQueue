class Solution {
    public void rearrangeQueue(Queue<Integer> q) {
        // code here
        int n = q.size();
        Queue<Integer> q1 = new LinkedList<>();
        for(int i=1; i<=n/2; i++){
            q1.add(q.remove());
        }
        
        for(int i=1; i<=n; i++){
            if(i%2==0){
                q.add(q.remove());
            }else{
                q.add(q1.remove());
            }
        }
    }
}

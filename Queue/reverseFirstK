class Solution {
    public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
        // code here
        if (k <= 0 || k > q.size()) return q;
        Stack<Integer> st = new Stack<>();
        for(int i =0 ; i<k; i++){
            st.push(q.remove());
        }
        
        
        for(int i=0; i<k; i++){
            q.add(st.pop());
        }
        
        int m = q.size() - k;
        
        for(int i=0; i<m; i++){
            int a = q.remove();
            q.add(a);
        }
        
        return q;
    }
}

class Solution {
    public int inversionCount(int arr[]) {
        // code here
        int n = arr.length;
        return mergeSort(arr, 0, n);
    }
    
    static int mergeSort(int[] arr, int l, int r) {
        if (l >= r) return 0;

        int mid = l + (r - l) / 2;

        int count = 0;

        count += mergeSort(arr, l, mid);
        count += mergeSort(arr, mid + 1, r);
        count += merge(arr, l, mid, r);

        return count;
    }

    static int merge(int[] arr, int l, int mid, int r) {
        int count = 0;

        int[] temp = new int[r - l + 1];

        int i = l;
        int j = mid + 1;
        int k = 0;

        while (i <= mid && j <= r) {

            if (arr[i] <= arr[j]) {
                temp[k++] = arr[i++];
            } 
            else {
                temp[k++] = arr[j++];

                // All remaining elements in left half
                // will form inversions with arr[j-1]
                count += (mid - i + 1);
            }
        }

        while (i <= mid)
            temp[k++] = arr[i++];

        while (j <= r)
            temp[k++] = arr[j++];

        for (i = l; i <= r; i++)
            arr[i] = temp[i - l];

        return count;
    }
}
